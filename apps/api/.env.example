# Database
DATABASE_URL="postgresql://userhub:userhub_secret@localhost:5432/userhub"

# Postgres (for docker-compose)
POSTGRES_USER=userhub
POSTGRES_PASSWORD=userhub_secret
POSTGRES_DB=userhub
POSTGRES_PORT=5432

# JWT
JWT_SECRET=change_me_in_production_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# App
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Analytics provider
MOCK_ANALYTICS_BASE_URL=http://localhost:3002
MOCK_ANALYTICS_TIMEOUT_MS=5000
MOCK_ANALYTICS_MAX_RETRIES=2
MOCK_ANALYTICS_BACKOFF_BASE_MS=300
ANALYTICS_IDEMPOTENCY_WINDOW_MINUTES=5

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
